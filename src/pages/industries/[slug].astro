---
import type { GetStaticPaths } from 'astro';

import ArrowRight from 'lucide-astro/ArrowRight';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Card from '@/components/ui/Card.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Button from '@/components/ui/Button.astro';
import Accordion from '@/components/ui/Accordion.astro';
import PageHero from '@/components/ui/PageHero.astro';
import HeroPanel from '@/components/ui/HeroPanel.astro';
import HeroPanelBlock from '@/components/ui/HeroPanelBlock.astro';
import HeroPanelNav from '@/components/ui/HeroPanelNav.astro';

import { breadcrumbSchema, faqPageSchema, webPageSchema, ORG_ID } from '@/lib/seo';
import { SITE_URL } from '@/lib/site';
import {
  industries,
  industryPath,
  getIndustry,
  type Industry,
} from '@/lib/industries';
import { getServicePages } from '@/lib/services';

/**
 * `/industries/<slug>` — the sector cross-section of the services catalog.
 *
 * Structure mirrors a service spoke deliberately: hero → orientation →
 * constraints → applications → related services → FAQ → CTA. A visitor who
 * has seen one page on this site can read any other without re-learning the
 * layout, and the `h2` sequence stays predictable for extraction.
 *
 * The section that makes this page worth having is "related services": it is
 * the link from a sector query to the page that sells the work. Without it an
 * industry page is a brochure that ranks and converts nothing.
 */
export const getStaticPaths = (() =>
  industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry: getIndustry(industry.slug)! },
  }))) satisfies GetStaticPaths;

interface Props {
  industry: Industry;
}

const { industry } = Astro.props;
const path = industryPath(industry.slug);
const relatedServices = getServicePages(industry.relatedServices);

/**
 * Hero panel rows. Same records as the "related services" band far down the
 * page — the section that makes this page worth having — but surfaced above
 * the fold, which is where a visitor arriving on a sector query decides
 * whether this site sells what they need.
 */
const serviceLinks = relatedServices.slice(0, 5).map((service) => ({
  label: service.cardTitle,
  href: `/services/${service.slug}`,
}));

const breadcrumbs = breadcrumbSchema(
  [
    { name: 'Home', path: '/' },
    { name: 'Industries', path: industryPath() },
    { name: industry.name, path },
  ],
  path,
);

const webPage = webPageSchema({
  path,
  name: industry.h1,
  description: industry.metaDescription,
  hasBreadcrumb: true,
});

/**
 * `Service` with `audience`, not a second copy of the service nodes the
 * spokes already own. This page describes the same services aimed at one
 * sector; `serviceType` names the work and `audience` names the sector, which
 * is the distinction a parser needs to avoid reading it as a duplicate offer.
 */
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE_URL}${path}#service`,
  name: industry.h1,
  description: industry.summary,
  serviceType: 'Custom software and AI development',
  provider: { '@id': ORG_ID },
  audience: { '@type': 'BusinessAudience', name: industry.name },
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${industry.name} engineering services`,
    itemListElement: relatedServices.map((service) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        '@id': `${SITE_URL}/services/${service.slug}#service`,
      },
    })),
  },
};

const faqPage = faqPageSchema(industry.faqs, path);
---

<BaseLayout
  title={industry.metaTitle}
  description={industry.metaDescription}
  canonical={path}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webPage)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />
  </Fragment>

  {/* ══════════════ HERO ══════════════ */}
  <PageHero
    eyebrow="Industry"
    title={industry.h1}
    lead={industry.summary}
    backdrop="ship"
    backdropIntensity="faint"
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Industries', href: industryPath() },
      { label: industry.name },
    ]}
  >
    <Fragment slot="actions">
      <Button href="/contact" variant="primary" size="lg">
        Discuss a {industry.name.split(' ')[0].toLowerCase()} project
        <ArrowRight size={16} aria-hidden="true" />
      </Button>
      <Button href={industryPath()} variant="secondary" size="lg">
        All sectors
      </Button>
    </Fragment>

    <HeroPanel
      slot="aside"
      footerLabel="Different constraint?"
      footerHref="/contact"
      footerCta="Tell us about it"
    >
      {/* Constraint titles only. The descriptions are the band below — this
          is the shape of the problem, not a second copy of it. */}
      <HeroPanelBlock label="What makes it hard here">
        <ul class="space-y-2.5">
          {
            industry.constraints.map((constraint) => (
              <li class="flex gap-2.5 text-body-sm text-body">
                <span class="mt-2 size-1 shrink-0 rounded-full bg-hairline-strong" aria-hidden="true" />
                <span>{constraint.title}</span>
              </li>
            ))
          }
        </ul>
      </HeroPanelBlock>

      {
        serviceLinks.length > 0 && (
          <HeroPanelBlock label="Services this involves" surface="soft">
            <HeroPanelNav items={serviceLinks} />
          </HeroPanelBlock>
        )
      }
    </HeroPanel>
  </PageHero>

  {/* ══════════════ ORIENTATION ══════════════ */}
  <Section surface="canvas" as="section" divided>
    <Reveal class="max-w-3xl">
      <Eyebrow class="mb-4">What is different here</Eyebrow>
      <h2 class="text-display-lg">Where {industry.name.split(' ')[0].toLowerCase()} projects actually go wrong</h2>
      {industry.intro.map((paragraph) => (
        <p class="mt-4 text-body-md text-body">{paragraph}</p>
      ))}
    </Reveal>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        industry.constraints.map((constraint, i) => (
          <Reveal delay={i * 60} class="flex">
            <Card surface="soft" elevation={2} padding="md" class="flex w-full flex-col">
              <h3 class="text-heading-sm text-ink">{constraint.title}</h3>
              <p class="mt-2 text-body-sm text-body">{constraint.description}</p>
            </Card>
          </Reveal>
        ))
      }
    </div>
  </Section>

  {/* ══════════════ APPLICATIONS ══════════════ */}
  <Section surface="canvas" as="section" divided>
    <Reveal class="max-w-3xl">
      <Eyebrow class="mb-4">What we build</Eyebrow>
      <h2 class="text-display-lg">Systems we build for {industry.name.toLowerCase()}</h2>
    </Reveal>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        industry.applications.map((application, i) => (
          <Reveal delay={i * 60} class="flex">
            <Card surface="soft" elevation={2} padding="md" class="flex w-full flex-col">
              <h3 class="text-heading-sm text-ink">{application.title}</h3>
              <p class="mt-2 text-body-sm text-body">{application.description}</p>
            </Card>
          </Reveal>
        ))
      }
    </div>
  </Section>

  {/* ══════════════ RELATED SERVICES ══════════════ */}
  <Section surface="canvas" spacing="tight" as="section" divided>
    <Reveal class="max-w-3xl">
      <Eyebrow class="mb-4">Related services</Eyebrow>
      <h2 class="text-display-lg">The services this usually involves</h2>
    </Reveal>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        relatedServices.map((service, i) => (
          <Reveal as="li" delay={i * 60} class="flex">
            <Card
              as="a"
              href={`/services/${service.slug}`}
              surface="soft"
              elevation={2}
              padding="sm"
              interactive
              class="flex w-full flex-col"
            >
              <span class="text-body-sm font-medium text-ink">{service.cardTitle}</span>
              <span class="mt-1.5 text-caption text-mute">{service.cardDescription}</span>
            </Card>
          </Reveal>
        ))
      }
    </ul>
  </Section>

  {/* ══════════════ FAQ ══════════════ */}
  <Section surface="canvas" spacing="tight" as="section" id="faq" divided>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-20">
      <Reveal>
        <Eyebrow class="mb-4">Questions</Eyebrow>
        <h2 class="text-display-lg">{industry.name}: common questions</h2>
      </Reveal>
      <Reveal delay={120}>
        {
          industry.faqs.map((faq) => (
            <Accordion question={faq.question} headingLevel="h3">
              {faq.answer}
            </Accordion>
          ))
        }
      </Reveal>
    </div>
  </Section>

  {/* ══════════════ OTHER INDUSTRIES ══════════════ */}
  <Section surface="canvas" spacing="tight" as="section" divided>
    <Eyebrow class="mb-4">Other sectors</Eyebrow>
    <ul class="flex flex-wrap gap-2">
      {
        industries
          .filter((other) => other.slug !== industry.slug)
          .map((other) => (
            <li>
              <a
                href={industryPath(other.slug)}
                class="inline-flex rounded-full border border-hairline px-3.5 py-1.5 text-body-sm text-body transition-colors hover:border-ink hover:text-ink"
              >
                {other.name}
              </a>
            </li>
          ))
      }
    </ul>
  </Section>

  {/* ══════════════ CTA ══════════════ */}
  <Section surface="invert" spacing="tight" as="section">
    <Reveal class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-display-md">Building something in this sector?</h2>
        <p class="mt-3 max-w-xl text-body-md opacity-80">
          Tell us the constraint you are working against. If we have not solved
          that particular problem before, we will tell you.
        </p>
      </div>
      <Button href="/contact" variant="primary" size="lg" class="shrink-0">
        Start a conversation
        <ArrowRight size={16} aria-hidden="true" />
      </Button>
    </Reveal>
  </Section>
</BaseLayout>
