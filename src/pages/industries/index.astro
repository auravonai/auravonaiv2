---
import ArrowRight from 'lucide-astro/ArrowRight';
import ChevronRight from 'lucide-astro/ChevronRight';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Card from '@/components/ui/Card.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Button from '@/components/ui/Button.astro';

import { breadcrumbSchema, webPageSchema } from '@/lib/seo';
import { SITE_URL } from '@/lib/site';
import { industries, industryPath } from '@/lib/industries';

/**
 * `/industries` — hub for the sector pages.
 *
 * Thin by design, exactly like `/services`: it routes and nothing more. The
 * detail belongs on the six pages beneath it, and anything explained here as
 * well as there is a signal split between a hub and its own spoke.
 *
 * Primary keyword: **AI development for industries** (catalog intent).
 * ESTIMATED — no volume data available on this Ahrefs plan. The reasoning is
 * in `docs/keyword-strategy.md`; this page exists mainly to give the six
 * sector pages a parent and a crawlable index, and only secondarily to rank
 * on its own.
 */

const path = industryPath();

const breadcrumbs = breadcrumbSchema(
  [
    { name: 'Home', path: '/' },
    { name: 'Industries', path },
  ],
  path,
);

const webPage = webPageSchema({
  path,
  name: 'Industries we build for',
  description:
    'AI and custom software engineering across fintech, healthcare, logistics, ecommerce, education, and property.',
  hasBreadcrumb: true,
  type: 'CollectionPage',
});

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${SITE_URL}${path}#itemlist`,
  numberOfItems: industries.length,
  itemListElement: industries.map((industry, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: industry.name,
    url: `${SITE_URL}${industryPath(industry.slug)}`,
  })),
};
---

<BaseLayout
  title="Industries We Build For — AI & Software Engineering | Auravon AI"
  description="AI and custom software across fintech, healthcare, logistics, ecommerce, education, and property — with the constraints each sector actually imposes."
  canonical={path}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webPage)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemList)} />
  </Fragment>

  <Section surface="soft" as="section">
    <nav aria-label="Breadcrumb" class="mb-10">
      <ol class="flex flex-wrap items-center gap-1.5 text-body-sm text-mute">
        <li><a href="/" class="transition-colors hover:text-ink">Home</a></li>
        <li aria-hidden="true"><ChevronRight size={12} aria-hidden="true" /></li>
        <li><span class="text-body" aria-current="page">Industries</span></li>
      </ol>
    </nav>

    <Reveal>
      <Eyebrow class="mb-4">Sectors</Eyebrow>
      <h1 class="max-w-4xl text-display-xl">
        Industries we build for
        <span class="block text-mute">and the constraints each one imposes</span>
      </h1>
      <p class="mt-6 max-w-2xl text-body-lg text-body">
        The same fifteen services look different depending on who they are for.
        A reconciliation engine in fintech and an inventory sync in retail are
        both integration work, but what makes them hard is not the same thing.
        These pages cover what changes.
      </p>
    </Reveal>
  </Section>

  <Section surface="canvas" as="section" divided>
    <h2 class="sr-only">All industries</h2>
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        industries.map((industry, i) => (
          <Reveal as="li" delay={i * 60} class="flex">
            <Card
              as="a"
              href={industryPath(industry.slug)}
              surface="soft"
              elevation={2}
              padding="md"
              interactive
              class="flex w-full flex-col"
            >
              <h3 class="text-heading-md text-ink">{industry.name}</h3>
              <p class="mt-2 grow text-body-sm text-body">
                {industry.cardDescription}
              </p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-body-sm text-link">
                {industry.applications.length} common builds
                <ArrowRight size={13} aria-hidden="true" />
              </span>
            </Card>
          </Reveal>
        ))
      }
    </ul>
  </Section>

  <Section surface="invert" spacing="tight" as="section">
    <Reveal class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-display-md">Not on this list?</h2>
        <p class="mt-3 max-w-xl text-body-md opacity-80">
          These are the sectors we write about, not the only ones we work in.
          The engineering transfers; the constraints are what we would need to
          learn from you.
        </p>
      </div>
      <Button href="/contact" variant="primary" size="lg" class="shrink-0">
        Tell us about it
        <ArrowRight size={16} aria-hidden="true" />
      </Button>
    </Reveal>
  </Section>
</BaseLayout>
