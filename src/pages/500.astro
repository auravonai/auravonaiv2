---
import ErrorPage from '@/components/error/ErrorPage.astro';

/**
 * `/500` — the server-error page.
 *
 * What Astro actually does with this file
 * --------------------------------------
 * `src/pages/500.astro` is a special route: for **on-demand rendered** pages,
 * Astro renders it automatically when a route throws, and passes it an `error`
 * prop. That is documented as *not* available for prerendered pages.
 *
 * This site is `output: 'static'`, so every page here is prerendered and the
 * automatic path will almost never fire — the only on-demand routes are the
 * two Razorpay endpoints under `/api/`, and they return JSON rather than HTML.
 *
 * So this page earns its place a different way: because it prerenders, it
 * builds to `dist/client/500.html`, and Netlify, Cloudflare Pages, and Vercel
 * will all serve that file for a 5xx if you point them at it. Without it those
 * hosts fall back to a generic white error page with no branding and no way
 * back to the site.
 *
 * **Configure the host to use it** — it is not automatic the way `404.html`
 * is. On Netlify/Cloudflare that is a line in `_redirects`; on Vercel it is
 * `vercel.json`. Untested until you do, so verify it after deploy.
 *
 * The `error` prop is deliberately not read or displayed. Astro's own docs
 * warn against surfacing error contents, and a stack trace tells an attacker
 * how the server is put together. Whoever needs the detail reads the server
 * logs; the visitor needs a way out.
 */

const destinations = [
  {
    label: 'Home',
    description: 'Start again from the top.',
    href: '/',
  },
  {
    label: 'AI & software services',
    description: 'The fifteen things we build.',
    href: '/services',
  },
  {
    label: 'Blog',
    description: 'Reading that does not depend on this page working.',
    href: '/blog',
  },
  {
    label: 'Contact',
    description: 'Tell us what broke — it helps us find it.',
    href: '/contact',
  },
];
---

<ErrorPage
  code="500"
  eyebrow="Error 500 — Server error"
  title="Something went wrong on our side."
  description="This one is us, not you. The request reached our server and the server failed to answer it. Trying again in a moment often works; if it doesn't, tell us and we'll take a look."
  metaTitle="Server Error"
  primary={{ label: 'Back to home', href: '/' }}
  secondary={{ label: 'Report the problem', href: '/contact' }}
  destinations={destinations}
/>
