---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPageContent from '@/components/pages/BlogPageContent.astro';
import { articles } from '@/lib/articles';
import { breadcrumbSchema, webPageSchema } from '@/lib/seo';

const breadcrumbs = breadcrumbSchema(
  [
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ],
  '/blog',
);

const webPage = webPageSchema({
  path: '/blog',
  name: 'Auravon AI Blog',
  description:
    'Practical articles on AI development, modern web engineering, and building products that hold up in production.',
  hasBreadcrumb: true,
  type: 'CollectionPage',
});

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Auravon AI Blog',
  description: 'Engineering and AI insights for founders and product teams.',
  url: 'https://auravonai.com/blog',
  itemListElement: articles.map((article, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://auravonai.com/blog/${article.slug}`,
    name: article.title,
  })),
};
---

<BaseLayout
  title="AI Development Blog — Engineering Guides"
  description="Practical guides on AI app cost, SaaS architecture, MVPs, Next.js performance, RAG chatbots, and automation — written by the engineers who ship them."
  canonical="/blog"
  remoteImages
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webPage)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(blogListSchema)} />
  </Fragment>

  <BlogPageContent />
</BaseLayout>
