---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaymentPageContent from '@/components/pages/PaymentPageContent.astro';

import { faqPageSchema, webPageSchema } from '@/lib/seo';
import { paymentFaqs } from '@/lib/payment-seo';

/**
 * `/payment` — request a custom proposal.
 *
 * This was the only page on the site rendering visible FAQ accordions with no
 * `FAQPage` JSON-LD behind them. The array now lives in
 * `src/lib/payment-seo.ts` and feeds both the rendered disclosures and the
 * node below, so the marked-up answers and the readable answers cannot drift.
 *
 * The WebPage node is emitted because `faqPageSchema()` anchors its FAQ to
 * `<page>#webpage`; without it that `isPartOf` would point at an `@id` no
 * node on the page defines.
 */

const DESCRIPTION =
  'Request a custom proposal from Auravon AI. No fixed packages — every digital marketing, web development, or ecommerce engagement is scoped to your goals. Free consultation included.';

const webPage = webPageSchema({
  path: '/payment',
  name: 'Request a Custom Proposal',
  description: DESCRIPTION,
});

const faqPage = faqPageSchema(paymentFaqs, '/payment');
---

<BaseLayout
  title="Request a Custom Proposal — Get a Free Quote"
  description={DESCRIPTION}
  canonical="/payment"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(webPage)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(faqPage)}
    />
  </Fragment>

  <PaymentPageContent />
</BaseLayout>
