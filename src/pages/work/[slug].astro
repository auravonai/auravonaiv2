---
import type { GetStaticPaths } from 'astro';
import ArrowLeft from 'lucide-astro/ArrowLeft';
import ArrowRight from 'lucide-astro/ArrowRight';
import ArrowUpRight from 'lucide-astro/ArrowUpRight';
import CheckCircle2 from 'lucide-astro/CheckCircle2';
import MousePointerClick from 'lucide-astro/MousePointerClick';
import Info from 'lucide-astro/Info';

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import HeroPanel from '@/components/ui/HeroPanel.astro';
import HeroPanelBlock from '@/components/ui/HeroPanelBlock.astro';
import Section from '@/components/ui/Section.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import WorkVideo from '@/components/work/WorkVideo.astro';
import PriceTag from '@/components/pricing/PriceTag.astro';
import CurrencySelect from '@/components/pricing/CurrencySelect.astro';
import BookingCTA from '@/components/pricing/BookingCTA.astro';

import { breadcrumbSchema, webPageSchema, ORG_ID } from '@/lib/seo';
import { SITE_URL } from '@/lib/site';
import {
  CONCEPT_NOTE,
  media,
  workPath,
  workProjects,
  type WorkProject,
} from '@/lib/work';

/**
 * `/work/<slug>` — one case study per live build.
 *
 * Order follows what a buyer wants to verify, fastest first: what it is and a
 * button to try it (hero) → watch it working (video) → what it does
 * (features, then admin) → look closer (screenshots) → what it is built with
 * and what one costs (stack + price) → book.
 *
 * Structured data: WebPage + BreadcrumbList as on every page, a
 * `CreativeWork` for the build itself, and a `VideoObject` for the
 * walkthrough so it can surface in video results.
 */
export const getStaticPaths = (() =>
  workProjects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: workProjects[(i - 1 + workProjects.length) % workProjects.length],
      next: workProjects[(i + 1) % workProjects.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  project: WorkProject;
  prev: WorkProject;
  next: WorkProject;
}

const { project, prev, next } = Astro.props;
const path = workPath(project.slug);
const url = `${SITE_URL}${path}`;
const startHref = `/start?service=${encodeURIComponent(project.service)}&ref=${project.slug}`;
const poster = media(project.slug, 'poster.webp');

const webPage = webPageSchema({
  path,
  name: project.seo.title,
  description: project.summary,
  hasBreadcrumb: true,
});

const breadcrumbs = breadcrumbSchema(
  [
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
    { name: project.name, path },
  ],
  path,
);

const creativeWork = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${url}#work`,
  name: project.name,
  headline: project.tagline,
  description: project.summary,
  url,
  image: `${SITE_URL}${poster}`,
  creator: { '@id': ORG_ID },
  genre: project.industry,
  keywords: project.stack.join(', '),
  sameAs: project.liveUrl,
};

const video = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  '@id': `${url}#video`,
  name: `${project.name} — walkthrough`,
  description: `Silent ${project.videoSeconds}-second walkthrough of ${project.name}: ${project.tagline}`,
  thumbnailUrl: `${SITE_URL}${poster}`,
  contentUrl: `${SITE_URL}${media(project.slug, 'walkthrough.mp4')}`,
  uploadDate: '2026-10-14',
  duration: `PT${project.videoSeconds}S`,
  publisher: { '@id': ORG_ID },
};
---

<BaseLayout
  title={project.seo.title}
  description={project.seo.description}
  canonical={path}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webPage)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(creativeWork)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(video)} />
  </Fragment>

  {/* ── Hero ───────────────────────────────────────────────────────── */}
  <PageHero
    eyebrow={project.kind}
    title={project.name}
    titleTail={`— ${project.tagline}`}
    tailLayout="block"
    lead={project.summary}
    backdrop="dots"
    backdropIntensity="faint"
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Work', href: '/work' },
      { label: project.name },
    ]}
  >
    <Fragment slot="actions">
      <Button href={project.liveUrl} variant="primary" size="lg" external>
        Open live demo
        <ArrowUpRight size={16} aria-hidden="true" />
      </Button>
      <Button href={startHref} variant="secondary" size="lg">Build one like this</Button>
    </Fragment>

    <p slot="meta" class="flex items-start gap-2 text-body-sm text-body">
      <MousePointerClick size={16} class="mt-0.5 shrink-0 text-mute" aria-hidden="true" />
      <span><span class="text-mute">Try this:</span> {project.tryThis}</span>
    </p>

    <HeroPanel slot="aside" footerLabel="Want a quote?" footerHref={startHref} footerCta="Book a scoping call">
      <HeroPanelBlock label="At a glance">
        <dl class="grid grid-cols-3 gap-3">
          {
            project.facts.map((fact) => (
              <div>
                <dt class="text-caption text-mute">{fact.label}</dt>
                <dd class="mt-1 text-body-sm font-medium text-ink">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </HeroPanelBlock>
      <HeroPanelBlock label="Built with">
        <ul class="flex flex-wrap gap-1.5">
          {project.stack.map((item) => <li><Badge>{item}</Badge></li>)}
        </ul>
      </HeroPanelBlock>
      <HeroPanelBlock label="A similar build" surface="soft">
        <PriceTag inr={project.priceFrom} prefix="From" variant="large" />
      </HeroPanelBlock>
    </HeroPanel>
  </PageHero>

  {/* ── Walkthrough video ──────────────────────────────────────────── */}
  <Section surface="canvas" spacing="tight" as="section">
    <Reveal class="max-w-2xl">
      <Eyebrow class="mb-4">Walkthrough · {project.videoSeconds}s · no sound</Eyebrow>
      <h2 class="text-display-lg">See {project.name} working</h2>
    </Reveal>
    <Reveal class="mt-8 overflow-hidden rounded-lg shadow-level-3">
      <WorkVideo
        src={media(project.slug, 'walkthrough.mp4')}
        poster={poster}
        label={`Walkthrough of ${project.name}: ${project.shots.map((s) => s.caption).join(', ')}`}
      />
    </Reveal>
  </Section>

  {/* ── Features ───────────────────────────────────────────────────── */}
  <Section surface="soft" spacing="tight" as="section" divided>
    <Reveal class="max-w-2xl">
      <Eyebrow class="mb-4">What we built</Eyebrow>
      <h2 class="text-display-lg">
        {project.category === 'platform' ? 'The member experience' : 'Features'}
      </h2>
    </Reveal>
    <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        project.features.map((feature, i) => (
          <Reveal as="li" delay={i * 50} class="flex">
            <Card surface="canvas" elevation={2} padding="lg" class="flex-1">
              <h3 class="text-display-sm">{feature.title}</h3>
              <p class="mt-2 text-body-sm text-body">{feature.description}</p>
            </Card>
          </Reveal>
        ))
      }
    </ul>

    {
      project.adminFeatures && (
        <Reveal class="mt-14 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
          <div>
            <h2 class="text-display-md">The admin console</h2>
            <p class="mt-3 text-body-md text-body">
              Everything an operator needs to run {project.name} day to day, without a
              developer.
            </p>
          </div>
          <ul class="space-y-3">
            {project.adminFeatures.map((item) => (
              <li class="flex gap-3 text-body-md text-body">
                <CheckCircle2 size={18} class="mt-0.5 shrink-0 text-link" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </Reveal>
      )
    }
  </Section>

  {/* ── Screenshots ────────────────────────────────────────────────── */}
  <Section surface="canvas" spacing="tight" as="section" divided>
    <Reveal class="max-w-2xl">
      <Eyebrow class="mb-4">Screens</Eyebrow>
      <h2 class="text-display-lg">A closer look</h2>
      <p class="mt-3 text-body-md text-body">Captured from the live build. Click any screen to open it full size.</p>
    </Reveal>
    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        project.shots.map((shot, i) => (
          <Reveal as="li" delay={(i % 2) * 60}>
            <figure>
              <a
                href={media(project.slug, `shot-${shot.n}.webp`)}
                class="block overflow-hidden rounded-lg shadow-level-2 transition-shadow hover:shadow-level-3"
              >
                <img
                  src={media(project.slug, `shot-${shot.n}-sm.webp`)}
                  srcset={`${media(project.slug, `shot-${shot.n}-sm.webp`)} 640w, ${media(project.slug, `shot-${shot.n}.webp`)} 1280w`}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  width="1280"
                  height="601"
                  alt={shot.alt}
                  loading="lazy"
                  decoding="async"
                  class="block w-full"
                  style="height:auto"
                />
              </a>
              <figcaption class="mt-3 text-body-sm text-body">{shot.caption}</figcaption>
            </figure>
          </Reveal>
        ))
      }
    </ul>

    <p class="mt-10 flex max-w-3xl items-start gap-2 text-body-sm text-mute">
      <Info size={16} class="mt-0.5 shrink-0" aria-hidden="true" />
      {CONCEPT_NOTE}
    </p>
  </Section>

  {/* ── Price + next steps ─────────────────────────────────────────── */}
  <Section surface="soft" spacing="tight" as="section" divided>
    <div class="price-band grid items-center gap-8">
      <Reveal class="max-w-2xl">
        <h2 class="text-display-lg">What a build like {project.name} costs</h2>
        <p class="mt-4">
          <PriceTag inr={project.priceFrom} prefix="Starting from" variant="large" />
        </p>
        <p class="mt-3 text-body-md text-body">
          The starting price covers a focused first version on your branding and content.
          Your written quote after the scoping call is the number you sign — and the
          {' '}<a href="/pricing" class="text-link hover:underline">pricing page</a> explains what moves it.
        </p>
        <CurrencySelect class="mt-5" />
      </Reveal>
      <div class="price-actions flex flex-col gap-3 sm:flex-row">
        <Button href={startHref} variant="primary" size="lg">
          Start your project
          <ArrowRight size={16} aria-hidden="true" />
        </Button>
        <Button href={project.liveUrl} variant="secondary" size="lg" external>Try the demo</Button>
      </div>
    </div>
  </Section>

  {/* ── Prev / next ────────────────────────────────────────────────── */}
  <nav aria-label="More projects" class="border-t border-hairline bg-canvas">
    <div class="container-page grid gap-4 py-10 sm:grid-cols-2">
      <a href={workPath(prev.slug)} class="group flex items-center gap-3 rounded-lg p-4 hover:bg-canvas-soft">
        <ArrowLeft size={18} class="text-mute" aria-hidden="true" />
        <span>
          <span class="block text-caption text-mute">Previous project</span>
          <span class="text-body-md font-medium text-ink">{prev.name}</span>
        </span>
      </a>
      <a href={workPath(next.slug)} class="next-link group flex items-center gap-3 rounded-lg p-4 hover:bg-canvas-soft">
        <span>
          <span class="block text-caption text-mute">Next project</span>
          <span class="text-body-md font-medium text-ink">{next.name}</span>
        </span>
        <ArrowRight size={18} class="text-mute" aria-hidden="true" />
      </a>
    </div>
  </nav>

  <BookingCTA heading={`Want something like ${project.name}?`} service={project.service} />
</BaseLayout>

<style>
  /* Page-scoped on purpose: utilities that only this page needs live here,
     not in the site-wide stylesheet every other page downloads. */
  @media (min-width: 1024px) {
    .price-band { grid-template-columns: minmax(0, 1fr) auto; }
    .price-actions { flex-direction: column; }
  }
  .next-link { justify-content: flex-end; text-align: right; }
</style>
