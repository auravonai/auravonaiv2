---
import ArrowRight from 'lucide-astro/ArrowRight';

import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import HeroPanel from '@/components/ui/HeroPanel.astro';
import HeroPanelBlock from '@/components/ui/HeroPanelBlock.astro';
import HeroPanelNav from '@/components/ui/HeroPanelNav.astro';
import { ABOUT_INTRO, ABOUT_LEDE, whatWeDo, workingPractice } from '@/lib/about-seo';

/**
 * `/about` hero.
 *
 * H1 decision: the primary keyword ("AI development company") leads, and the
 * qualifier that follows is the page's actual thesis rather than a second
 * keyword. The word "About" is carried by the eyebrow, the breadcrumb, the
 * title tag, and the URL — spending H1 characters on it would push the
 * keyword out of the strongest position on the page for no gain.
 *
 * The visible breadcrumb is not decoration: Google requires BreadcrumbList
 * markup to match a hierarchy the visitor can see, and this page emits that
 * markup. The trail here and the schema in `src/pages/about.astro` must stay
 * in step.
 *
 * REMOVED: a `companyFacts` definition list ("Building software since 2019",
 * "Registered in Vadodara, Gujarat, India", "Clients: Remote, worldwide",
 * "Team shape: Small and senior"). Those values were inferred from the old
 * page's timeline and from the Organization schema rather than confirmed with
 * anyone, and at least one was wrong. Do not reintroduce a facts strip here
 * unless every value has been checked against reality — the About page is
 * exactly where a buyer verifies claims, so a wrong one costs more here than
 * anywhere else on the site.
 *
 * THE PANEL FOLLOWS THAT SAME RULE. It carries no dates, no headcount, no
 * location, and no metric. Every line in it is either a link to another page
 * on this site or a working-practice commitment already stated verbatim in
 * `about-seo.ts` — things checkable against how we behave, not claims about
 * a history nobody has confirmed. Do not add a "founded / team size / clients
 * served" block here.
 *
 * Backdrop is a neutral texture rather than a brand gradient pair. The three
 * gradient pairs are spoken for by the three practice hubs, and /about
 * belongs to no practice — it is the company behind both.
 */

/** First three working-practice commitments, titles only. Full text is the
 *  AboutPractice band; this is a summary of it, not a second copy. */
const practiceTitles = workingPractice.slice(0, 3).map((item) => item.title);

/** The four `whatWeDo` destinations, as panel rows. Same records the
 *  AboutWhatWeDo band renders, so the two can never disagree. */
const doLinks = whatWeDo.map((item) => ({
  label: item.title,
  href: item.href,
}));
---

<PageHero
  eyebrow="About Auravon AI"
  title="An AI Development Company"
  titleTail="Run by the Engineers Who Build It"
  lead={ABOUT_INTRO}
  leads={[ABOUT_LEDE]}
  backdrop="rules"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'About' }]}
>
  <Fragment slot="actions">
    <Button href="/contact" variant="primary" size="lg">
      Talk to an Engineer
      <ArrowRight
        size={16}
        class="transition-transform duration-150 group-hover:translate-x-0.5"
        aria-hidden="true"
      />
    </Button>
    <Button href="/projects" variant="secondary" size="lg">
      See What We Have Built
    </Button>
  </Fragment>

  <HeroPanel
    slot="aside"
    footerLabel="Prefer to just ask?"
    footerHref="/contact"
    footerCta="Start a conversation"
  >
    <HeroPanelBlock label="How we work">
      <ul class="space-y-2.5">
        {
          practiceTitles.map((title) => (
            <li class="flex gap-2.5 text-body-sm text-body">
              <span
                class="mt-2 size-1 shrink-0 rounded-full bg-hairline-strong"
                aria-hidden="true"
              />
              <span>{title}</span>
            </li>
          ))
        }
      </ul>
    </HeroPanelBlock>

    <HeroPanelBlock label="What we do" surface="soft">
      <HeroPanelNav items={doLinks} />
    </HeroPanelBlock>
  </HeroPanel>
</PageHero>
