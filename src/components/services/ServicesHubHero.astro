---
import ArrowRight from 'lucide-astro/ArrowRight';
import CheckCircle2 from 'lucide-astro/CheckCircle2';

import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import HeroPanel from '@/components/ui/HeroPanel.astro';
import HeroPanelBlock from '@/components/ui/HeroPanelBlock.astro';
import HeroPanelNav from '@/components/ui/HeroPanelNav.astro';

import { SERVICES_INTRO } from '@/lib/services-seo';
import {
  serviceCategories,
  servicePages,
  servicesByCategory,
} from '@/lib/services';

/**
 * `/services` hero.
 *
 * The hub's job is to route, and the panel now does that from inside the
 * hero band instead of making a visitor scroll to the card grid first. Each
 * row is a real link to that category's section with its page count beside
 * it, so the shape of the catalog is legible before any scrolling happens.
 *
 * Backdrop is the `develop` pair (blue → teal). Each hub takes one DESIGN.md
 * gradient pair so a visitor can tell which practice they are in from the
 * band alone; spokes take a neutral texture instead. HeroBackdrop explains
 * why the line is drawn there.
 *
 * Kept from the previous version, and still true:
 * - The in-page table of contents is gone. Those fifteen `#anchor` targets
 *   are fifteen URLs now, and the card grid below is the real index.
 * - The visible breadcrumb stays, because this page emits BreadcrumbList
 *   markup and Google requires the two to match.
 */

const assurances = [
  'Free 30-minute scoping call',
  'Costed scope before you commit',
  'You own the code and the IP',
];

/**
 * Category rows for the panel. Counts are derived rather than written down,
 * so adding a service updates the hero without anyone remembering to.
 */
const categoryLinks = serviceCategories.map((category) => ({
  label: category.label,
  href: `#${category.id}-services`,
  meta: String(servicesByCategory(category.id).length),
}));

/**
 * How an engagement starts. Process commitments, not outcome claims — the
 * same test every claim on this site has to pass. Each line is checkable
 * against how we actually behave.
 */
const startSteps = [
  'A 30-minute call about the problem, not the tech',
  'A written, costed scope — including what is out of it',
  'Build in reviewable increments you can open',
];
---

<PageHero
  eyebrow="What We Build"
  title="AI Development Services"
  titleTail="Built for Production"
  lead={SERVICES_INTRO}
  backdrop="develop"
  asideWidth="sm"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
>
  <ul
    slot="meta"
    class="flex flex-wrap items-center gap-x-6 gap-y-3 text-body-sm text-body"
  >
    {
      assurances.map((item) => (
        <li class="flex items-center gap-1.5">
          <CheckCircle2 size={14} class="text-mute" aria-hidden="true" />
          {item}
        </li>
      ))
    }
  </ul>

  <Fragment slot="actions">
    <Button href="/contact" variant="primary" size="lg">
      Get a Free Project Scope
      <ArrowRight
        size={16}
        class="transition-transform duration-150 group-hover:translate-x-0.5"
        aria-hidden="true"
      />
    </Button>
    <Button href="#ai-services" variant="secondary" size="lg">
      Browse Services
    </Button>
  </Fragment>

  <HeroPanel
    slot="aside"
    footerLabel="Not sure which?"
    footerHref="/contact"
    footerCta="Talk it through"
  >
    <HeroPanelBlock label={`Service index · ${servicePages.length} pages`}>
      <HeroPanelNav items={categoryLinks} />
    </HeroPanelBlock>

    <HeroPanelBlock label="How engagements start" surface="soft">
      <ol class="space-y-3">
        {
          startSteps.map((step, i) => (
            <li class="flex gap-3 text-body-sm text-body">
              <span
                class="shrink-0 font-mono text-caption text-mute"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
    </HeroPanelBlock>
  </HeroPanel>
</PageHero>
