---
import Mail from 'lucide-astro/Mail';
import Shield from 'lucide-astro/Shield';
import FileText from 'lucide-astro/FileText';
import RotateCcw from 'lucide-astro/RotateCcw';
import ArrowUpRight from 'lucide-astro/ArrowUpRight';

import Logo from '@/components/layout/Logo.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import { serviceCategories, servicesByCategory } from '@/lib/services';
import {
  MARKETING_LABEL,
  getMarketingCategories,
  hasMarketingPage,
  marketingPath,
} from '@/lib/marketing';
import { COMPANY_LINKS, EMAILS, LEGAL_LINKS, SOCIALS } from '@/lib/site';

/** Legal-link glyphs only — the social marks come from BrandIcon. */
const icons: Record<string, unknown> = {
  Shield,
  FileText,
  RotateCcw,
};

const bottomLinks = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Refund', href: '/refund' },
  { label: 'Contact', href: '/contact' },
  { label: 'All Services', href: '/services' },
];

const year = new Date().getFullYear();

const columnHeading =
  'mb-4 font-mono text-caption uppercase tracking-[0.08em] text-mute';
const footerLink =
  'text-body-sm text-body transition-colors hover:text-ink';
---

<footer class="border-t border-hairline bg-canvas-soft">
  <div class="container-page py-16 md:py-20">
    {/* ── AI & software services ──
         The footer link block is site-wide, so what it lists is effectively a
         statement about what the domain is for. It leads with the fifteen
         engineering spokes for that reason. */}
    <div class="mb-14">
      <p class={columnHeading}>AI &amp; Software Engineering</p>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:grid-cols-4">
        {
          serviceCategories.map((cat) => (
            <div class="min-w-0">
              <p class="mb-3 text-body-sm font-medium text-ink">{cat.label}</p>
              <ul class="space-y-2">
                {servicesByCategory(cat.id).map((service) => (
                  <li>
                    <a
                      href={`/services/${service.slug}`}
                      class="group inline-flex items-center gap-1 text-body-sm text-body transition-colors hover:text-ink"
                    >
                      {service.cardTitle}
                      <ArrowUpRight
                        size={10}
                        class="opacity-0 transition-opacity group-hover:opacity-60" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    {/* ── Digital marketing ──
         Category pages only, not all 26 sub-services. A site-wide footer that
         links every leaf page spreads internal link equity evenly across
         pages of very different value; linking the eight category pages
         concentrates it where the hub-and-spoke structure wants it, and the
         leaves are one click further on. */}
    <div class="mb-14">
      <p class={columnHeading}>{MARKETING_LABEL}</p>
      <ul class="grid grid-cols-2 gap-x-8 gap-y-2 sm:grid-cols-3 md:grid-cols-4">
        {
          getMarketingCategories()
            .filter((cat) => hasMarketingPage(cat.slug))
            .map((cat) => (
              <li>
                <a
                  href={marketingPath(cat.slug)}
                  class="group inline-flex items-center gap-1 text-body-sm text-body transition-colors hover:text-ink"
                >
                  {cat.label}
                  <ArrowUpRight
                    size={10}
                    class="opacity-0 transition-opacity group-hover:opacity-60" aria-hidden="true" />
                </a>
              </li>
            ))
        }
      </ul>
    </div>

    <div class="mb-14 border-t border-hairline"></div>

    {/* ── Bottom grid ── */}
    <div
      class="mb-14 grid grid-cols-1 gap-12 sm:grid-cols-2 md:grid-cols-4 md:gap-8 lg:grid-cols-5 lg:gap-10"
    >
      {/* Brand */}
      <div class="min-w-0 sm:col-span-2 md:col-span-4 lg:col-span-2">
        <Logo class="mb-5" />

        <p class="mb-1 max-w-[280px] text-body-sm text-body">
          Full-service digital agency serving businesses in India, USA, UK,
          Australia, UAE, and worldwide.
        </p>
        <p class="mb-6 text-caption text-mute">
          We typically respond within 24 hours.
        </p>

        {/* Instagram, LinkedIn, X, and WhatsApp — the whole set. The mark
             inherits `currentColor`, so the same icon is correct on the light
             canvas and the dark one with no per-theme asset or rule.

             WhatsApp is here and nowhere else in the footer. A "Chat on
             WhatsApp" button used to sit directly below this row, which put
             the same destination on screen twice within about 40px. The row
             is the one that survives: it reads as one set of four places to
             reach the company, and the floating WhatsApp button already
             carries the CTA weight site-wide. */}
        <ul class="flex items-center gap-2.5">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="flex size-9 items-center justify-center rounded-sm bg-canvas text-body shadow-level-1 transition-colors hover:text-ink hover:shadow-level-2"
                >
                  <BrandIcon name={social.icon} size={14} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Company */}
      <div class="min-w-0">
        <p class={columnHeading}>Company</p>
        <ul class="space-y-2.5">
          {
            COMPANY_LINKS.map((c) => (
              <li>
                <a href={c.href} class={footerLink}>
                  {c.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Legal */}
      <div class="min-w-0">
        <p class={columnHeading}>Legal</p>
        <ul class="space-y-2.5">
          {
            LEGAL_LINKS.map((l) => {
              const Icon = (icons[l.icon] ?? FileText) as any;
              return (
                <li>
                  <a href={l.href} class:list={[footerLink, 'flex items-center gap-1.5']}>
                    <Icon size={12} class="shrink-0" aria-hidden="true" />
                    {l.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      {/* Contact */}
      <div class="min-w-0 sm:col-span-2 md:col-span-1">
        <p class={columnHeading}>Contact</p>
        <ul class="space-y-3">
          {
            EMAILS.map(({ type, addr }) => (
              <li>
                <p class="mb-0.5 font-mono text-caption uppercase tracking-[0.08em] text-mute">
                  {type}
                </p>
                <a
                  href={`mailto:${addr}`}
                  class="flex items-center gap-1 text-body-sm text-body transition-colors hover:text-link"
                >
                  <Mail size={12} class="shrink-0" aria-hidden="true" />
                  {addr}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* ── Bottom bar ── */}
    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-hairline pt-8 sm:flex-row"
    >
      <p class="text-caption text-mute">
        © {year} Auravon AI · India &amp; Worldwide
      </p>

      <ul class="flex flex-wrap items-center justify-center gap-5">
        {
          bottomLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="text-caption text-mute transition-colors hover:text-ink"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="flex items-center gap-1.5 text-caption text-mute">
        <span class="size-1.5 rounded-full bg-link" aria-hidden="true"></span>
        All systems operational
      </p>
    </div>
  </div>
</footer>
