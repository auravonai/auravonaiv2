---
import ArrowRight from 'lucide-astro/ArrowRight';

import Reveal from '@/components/ui/Reveal.astro';
import Button from '@/components/ui/Button.astro';
import { BOOKING_FEE_INR, formatInr } from '@/lib/pricing';
import { WHATSAPP_URL } from '@/lib/site';

/**
 * Closing band for /work, /pricing and the case studies. Same visual as
 * ServicesHubCTA. States the booking terms in full so the ₹1,000 is never
 * a surprise on the next page.
 */
interface Props {
  heading?: string;
  /** Pre-selects a service on /start. */
  service?: string;
}

const { heading = 'Ready to start your project?', service } = Astro.props;
const href = service ? `/start?service=${encodeURIComponent(service)}` : '/start';
const fee = formatInr(BOOKING_FEE_INR);
---

<section class="bg-canvas pb-20">
  <div class="container-page">
    <Reveal class="rounded-xl bg-invert px-8 py-14 text-center text-on-invert md:p-16">
      <h2 class="text-display-lg">{heading}</h2>

      <p class="mx-auto mt-4 max-w-xl text-body-md text-on-invert/70">
        Pick a time for a Google Meet or Microsoft Teams call with the engineer who would
        build it. A {fee} booking confirms the slot — it is credited to your project, and
        refunded in full if our quote doesn’t fit your budget.
      </p>

      <ul
        class="mx-auto mt-8 mb-9 flex max-w-2xl flex-wrap items-center justify-center gap-x-6 gap-y-2 text-body-sm text-on-invert/70"
      >
        <li>{fee} fully refundable</li>
        <li aria-hidden="true">·</li>
        <li>Written quote within 3 business days</li>
        <li aria-hidden="true">·</li>
        <li>NDA on request</li>
      </ul>

      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={href} variant="secondary" size="lg">
          Book your meeting
          <ArrowRight
            size={16}
            class="transition-transform duration-150 group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </Button>
        <Button
          href={WHATSAPP_URL}
          variant="ghost"
          size="lg"
          external
          class="text-on-invert shadow-[inset_0_0_0_1px_var(--color-invert-line)] hover:bg-on-invert/10 hover:text-on-invert"
        >
          Questions first? WhatsApp us
        </Button>
      </div>
    </Reveal>
  </div>
</section>
