---
import ArrowRight from 'lucide-astro/ArrowRight';
import Clock from 'lucide-astro/Clock';
import Users from 'lucide-astro/Users';
import Search from 'lucide-astro/Search';
import FileText from 'lucide-astro/FileText';
import Zap from 'lucide-astro/Zap';
import GitBranch from 'lucide-astro/GitBranch';

import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Card from '@/components/ui/Card.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import HeroPanel from '@/components/ui/HeroPanel.astro';
import HeroPanelBlock from '@/components/ui/HeroPanelBlock.astro';
import DashboardMockup from '@/components/projects/DashboardMockup.astro';
import {
  projects,
  projectCategories,
  projectIndustries,
} from '@/lib/projects';

const workingStyle = [
  {
    icon: Search,
    title: 'Start with the problem',
    desc: "Before any code, we understand what's actually broken, what's been tried, and what success looks like for your specific team.",
  },
  {
    icon: FileText,
    title: 'Plan before we build',
    desc: 'Data model, user flows, and integration points defined upfront. Architecture surprises mid-sprint are expensive for everyone.',
  },
  {
    icon: Zap,
    title: 'Ship working software early',
    desc: 'A working build in the first 1–2 weeks. You can test it, redirect it, and see that real progress is happening.',
  },
  {
    icon: GitBranch,
    title: 'Hand over cleanly',
    desc: 'Docs, codebase walkthrough, and admin access at the end. You should be able to extend what we built without us on speed dial.',
  },
];

const featured = projects.find((p) => p.featured);
const regular = projects.filter((p) => !p.featured);

/**
 * Hero panel counts.
 *
 * All three are `projects.length`-style derivations off the records rendered
 * further down this same page — nothing here asserts a company fact that is
 * not already visible as a card below. Do not add "years in business",
 * "clients served", or any figure that cannot be counted from this file.
 *
 * `projectCategories` and `projectIndustries` both open with an "All" entry
 * for the filter bar, which is why each count drops one.
 */
const buildCount = projects.length;
const categoryCount = Math.max(projectCategories.length - 1, 0);
const industryCount = Math.max(projectIndustries.length - 1, 0);
---

{/* ── Hero ── */}
<PageHero
  eyebrow="Portfolio"
  title="Software We've"
  titleTail="Designed & Shipped"
  lead="A selection of web apps, mobile products, AI integrations, and internal tools built for founders and engineering teams."
  backdrop="grid"
  asideWidth="sm"
>
  <Fragment slot="actions">
    <Button href="/contact" variant="primary" size="lg">
      Discuss your project
      <ArrowRight
        size={16}
        class="transition-transform duration-150 group-hover:translate-x-0.5"
        aria-hidden="true"
      />
    </Button>
    <Button href="/services" variant="secondary" size="lg">
      What we build
    </Button>
  </Fragment>

  <HeroPanel
    slot="aside"
    footerLabel="Something similar?"
    footerHref="/contact"
    footerCta="Tell us about it"
  >
    <HeroPanelBlock label="In this portfolio">
      <dl class="space-y-3">
        {
          [
            { term: 'Builds documented', value: buildCount },
            { term: 'Product categories', value: categoryCount },
            { term: 'Industries served', value: industryCount },
          ].map(({ term, value }) => (
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-body-sm text-body">{term}</dt>
              <dd class="font-mono text-body-sm text-ink tabular-nums">
                {value}
              </dd>
            </div>
          ))
        }
      </dl>
    </HeroPanelBlock>

    <HeroPanelBlock label="Every entry lists" surface="soft">
      <ul class="space-y-2 text-body-sm text-body">
        <li>The problem it was built to solve</li>
        <li>The approach taken, and the stack</li>
        <li>Timeline and team shape</li>
      </ul>
    </HeroPanelBlock>
  </HeroPanel>
</PageHero>

{/* ── Filter bar ── */}
<div
  class="sticky top-16 z-30 border-b border-hairline bg-canvas/90 py-4 backdrop-blur-xl"
>
  <div class="container-page">
    <div
      class="flex flex-wrap justify-center gap-2"
      role="group"
      aria-label="Filter projects by category"
    >
      {
        projectCategories.map((cat, i) => (
          <button
            type="button"
            data-filter={cat}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-pill-sm px-4 py-2 text-body-sm shadow-level-1 transition-[background-color,color,box-shadow] aria-pressed:bg-ink aria-pressed:text-on-primary bg-canvas text-body hover:text-ink hover:shadow-level-2"
          >
            {cat}
          </button>
        ))
      }
    </div>
  </div>
</div>

{/* ── Projects grid ── */}
<section class="bg-canvas py-16 md:py-20">
  <div class="container-page">
    <div id="projects-grid" class="grid gap-6 md:grid-cols-2">
      {/* Featured card — only shown while the "All" filter is active. */}
      {
        featured && (
          <Reveal
            as="article"
            data-project
            data-category={featured.category}
            data-featured="true"
            class="md:col-span-2"
          >
            <Card surface="canvas" elevation={3} padding="lg" class="h-full">
              <div class="grid items-start gap-8 lg:grid-cols-2">
                <div>
                  <div class="mb-4 flex items-center gap-3">
                    <Badge variant="outline">{featured.category}</Badge>
                    <span class="font-mono text-caption uppercase tracking-[0.08em] text-mute">
                      Featured project
                    </span>
                  </div>

                  <h2 class="text-display-lg">{featured.title}</h2>
                  <p class="mt-3 mb-5 text-body-sm text-body">
                    {featured.description}
                  </p>

                  <dl class="mb-6 space-y-3">
                    <div class="flex items-start gap-2.5">
                      <span
                        class="mt-1.5 size-1.5 shrink-0 rounded-full bg-error"
                        aria-hidden="true"
                      />
                      <div>
                        <dt class="mb-0.5 font-mono text-caption uppercase tracking-[0.08em] text-mute">
                          Problem
                        </dt>
                        <dd class="text-body-sm text-body">{featured.problem}</dd>
                      </div>
                    </div>
                    <div class="flex items-start gap-2.5">
                      <span
                        class="mt-1.5 size-1.5 shrink-0 rounded-full bg-link"
                        aria-hidden="true"
                      />
                      <div>
                        <dt class="mb-0.5 font-mono text-caption uppercase tracking-[0.08em] text-mute">
                          Solution
                        </dt>
                        <dd class="text-body-sm text-body">{featured.solution}</dd>
                      </div>
                    </div>
                  </dl>

                  <ul class="mb-6 flex flex-wrap gap-3">
                    {featured.highlights.map(({ label, value }) => (
                      <li class="rounded-md bg-canvas-soft px-3 py-2">
                        <span class="block text-body-sm font-medium text-ink">
                          {value}
                        </span>
                        <span class="mt-0.5 block text-caption text-mute">
                          {label}
                        </span>
                      </li>
                    ))}
                    <li class="rounded-md bg-canvas-soft px-3 py-2">
                      <span class="block text-body-sm font-medium text-ink">
                        {featured.duration}
                      </span>
                      <span class="mt-0.5 block text-caption text-mute">Timeline</span>
                    </li>
                    <li class="rounded-md bg-canvas-soft px-3 py-2">
                      <span class="block text-body-sm font-medium text-ink">
                        {featured.teamSize}
                      </span>
                      <span class="mt-0.5 block text-caption text-mute">Team</span>
                    </li>
                  </ul>

                  <ul class="flex flex-wrap gap-1.5">
                    {featured.technologies.map((tech) => (
                      <li>
                        <Badge variant="outline">{tech}</Badge>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="hidden lg:block">
                  <DashboardMockup />
                </div>
              </div>
            </Card>
          </Reveal>
        )
      }

      {
        regular.map((project, i) => (
          <Reveal
            as="article"
            delay={i * 70}
            data-project
            data-category={project.category}
            class="flex"
          >
            <Card
              surface="canvas"
              elevation={2}
              padding="lg"
              interactive
              class="flex flex-1 flex-col"
            >
              <div class="mb-4 flex items-start justify-between gap-4">
                <Badge variant="outline">{project.category}</Badge>
                <span
                  class="flex size-10 shrink-0 items-center justify-center rounded-md bg-canvas-soft text-display-sm text-mute"
                  aria-hidden="true"
                >
                  {project.title.charAt(0)}
                </span>
              </div>

              <h2 class="text-display-sm">{project.title}</h2>
              <p class="mt-2 mb-4 flex-1 text-body-sm text-body">
                {project.description}
              </p>

              <div class="mb-4 space-y-2.5 rounded-md bg-canvas-soft p-4">
                <p class="flex items-start gap-2 text-body-sm text-body">
                  <span
                    class="mt-1.5 size-1.5 shrink-0 rounded-full bg-error"
                    aria-hidden="true"
                  />
                  {project.problem}
                </p>
                <p class="flex items-start gap-2 text-body-sm text-body">
                  <span
                    class="mt-1.5 size-1.5 shrink-0 rounded-full bg-link"
                    aria-hidden="true"
                  />
                  {project.solution}
                </p>
              </div>

              <ul class="mb-4 flex flex-wrap items-center gap-2">
                {project.highlights.map(({ label, value }) => (
                  <li class="flex items-center gap-1.5 rounded-sm bg-canvas-soft px-2.5 py-1.5">
                    <span class="text-caption font-medium text-ink">{value}</span>
                    <span class="text-caption text-mute">{label}</span>
                  </li>
                ))}
                <li class="flex items-center gap-1.5 text-caption text-mute">
                  <Clock size={12} aria-hidden="true" />
                  {project.duration}
                </li>
                <li class="flex items-center gap-1.5 text-caption text-mute">
                  <Users size={12} aria-hidden="true" />
                  {project.teamSize}
                </li>
              </ul>

              <ul class="flex flex-wrap gap-1.5 border-t border-hairline pt-4">
                {project.technologies.slice(0, 4).map((tech) => (
                  <li>
                    <Badge variant="outline">{tech}</Badge>
                  </li>
                ))}
              </ul>
            </Card>
          </Reveal>
        ))
      }
    </div>

    <p id="projects-empty" hidden class="py-12 text-center text-body-md text-body">
      No projects in this category yet.
    </p>
  </div>
</section>

{/* ── Industries band ── */}
<section class="border-y border-hairline bg-canvas-soft py-10">
  <div class="container-page">
    <Reveal
      class="flex flex-col flex-wrap items-center justify-between gap-6 sm:flex-row"
    >
      <p class="shrink-0 font-mono text-caption uppercase tracking-[0.08em] text-mute">
        Industries
      </p>
      <ul class="flex flex-1 flex-wrap justify-center gap-2 sm:justify-start">
        {
          projectIndustries.map((ind) => (
            <li>
              <span class="inline-block rounded-sm bg-canvas px-3 py-1.5 text-body-sm text-body shadow-level-1">
                {ind}
              </span>
            </li>
          ))
        }
      </ul>
    </Reveal>
  </div>
</section>

{/* ── How we work ── */}
<Section surface="canvas" spacing="tight" class="border-b border-hairline">
  <SectionHeader
    eyebrow="Process"
    title="How We Approach Every Project"
    lead="The same core workflow applies whether we're building a 5-day landing page or a 16-week mobile system."
    class="mb-12"
  />

  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      workingStyle.map(({ icon, title, desc }, i) => {
        const Icon = icon as any;
        return (
          <Reveal as="li" delay={i * 80} class="flex">
            <Card surface="soft" elevation={1} class="flex-1">
              <span class="mb-4 flex size-9 items-center justify-center rounded-md bg-canvas text-ink shadow-level-1">
                <Icon size={18} aria-hidden="true" />
              </span>
              <p class="mb-1 font-mono text-caption uppercase tracking-[0.08em] text-mute">
                Step {i + 1}
              </p>
              <h3 class="text-body-md font-medium text-ink">{title}</h3>
              <p class="mt-2 text-body-sm text-body">{desc}</p>
            </Card>
          </Reveal>
        );
      })
    }
  </ol>
</Section>

{/* ── Bottom CTA ── */}
<Section surface="canvas" spacing="tight">
  <Reveal class="mx-auto max-w-2xl text-center">
    <p class="mb-6 inline-flex items-center gap-2 text-body-sm text-body">
      <span class="size-1.5 rounded-full bg-link" aria-hidden="true"></span>
      Available for new projects · We reply within a day
    </p>
    <h2 class="text-display-xl">
      Building Something? <span class="text-mute">Let's Talk.</span>
    </h2>
    <p class="mt-4 mb-8 text-body-md text-body">
      Whether you have a detailed spec or just an idea — share what you're
      working on and we'll have an honest conversation about what it takes to
      build it right.
    </p>
    <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href="/contact" variant="primary" size="lg">
        Discuss Your Project
        <ArrowRight size={16} class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true" />
      </Button>
      <Button href="/services" variant="secondary" size="lg">
        View Our Services
      </Button>
    </div>
  </Reveal>
</Section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-project]');
  const empty = document.getElementById('projects-empty');

  function applyFilter(active: string) {
    let visible = 0;

    for (const card of cards) {
      // The featured card is an "All"-only flourish, matching the reference.
      const isFeatured = card.dataset.featured === 'true';
      const matches =
        active === 'All' ? true : !isFeatured && card.dataset.category === active;

      card.hidden = !matches;
      if (matches) visible += 1;
    }

    if (empty) empty.hidden = visible > 0;

    for (const button of buttons) {
      button.setAttribute(
        'aria-pressed',
        String(button.dataset.filter === active),
      );
    }
  }

  for (const button of buttons) {
    button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'All'));
  }
</script>
