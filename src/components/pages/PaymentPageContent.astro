---
import CheckCircle2 from 'lucide-astro/CheckCircle2';
import Shield from 'lucide-astro/Shield';
import ArrowRight from 'lucide-astro/ArrowRight';
import Lock from 'lucide-astro/Lock';
import ChevronDown from 'lucide-astro/ChevronDown';
import FileText from 'lucide-astro/FileText';
import MessageSquare from 'lucide-astro/MessageSquare';
import Package from 'lucide-astro/Package';
import Headphones from 'lucide-astro/Headphones';
import TrendingUp from 'lucide-astro/TrendingUp';
import Globe from 'lucide-astro/Globe';
import ShoppingCart from 'lucide-astro/ShoppingCart';
import Share2 from 'lucide-astro/Share2';
import Palette from 'lucide-astro/Palette';
import Briefcase from 'lucide-astro/Briefcase';
import CreditCard from 'lucide-astro/CreditCard';
import MessageCircle from 'lucide-astro/MessageCircle';

import Card from '@/components/ui/Card.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Field from '@/components/ui/Field.astro';
import Accordion from '@/components/ui/Accordion.astro';
import { paymentFaqs } from '@/lib/payment-seo';
import { WHATSAPP_NUMBER } from '@/lib/site';

const serviceOptions = [
  { icon: TrendingUp, label: 'Digital Marketing & SEO' },
  { icon: Globe, label: 'Website Development' },
  { icon: ShoppingCart, label: 'Ecommerce Solutions' },
  { icon: Share2, label: 'Social Media Management' },
  { icon: Palette, label: 'Graphic Design & Branding' },
  { icon: Briefcase, label: 'Business Consulting' },
];

const budgetRanges = [
  'Under ₹25,000',
  '₹25,000 – ₹75,000',
  '₹75,000 – ₹2,00,000',
  '₹2,00,000+',
  'Not sure yet',
];

const trustCards = [
  {
    icon: FileText,
    title: 'Clear Scope, No Surprises',
    desc: "Deliverables and timelines agreed before we start. You always know exactly what's being done and when.",
  },
  {
    icon: MessageSquare,
    title: 'Direct Communication',
    desc: 'You speak directly to the team building your campaigns — no account managers, no layers of bureaucracy.',
  },
  {
    icon: Package,
    title: 'Measurable Results',
    desc: 'We report on what matters — leads generated, traffic growth, conversions — not just vanity metrics.',
  },
  {
    icon: Headphones,
    title: 'Ongoing Support',
    desc: "We don't disappear after launch. Every engagement includes continued support and regular performance reviews.",
  },
];

// Moved to `src/lib/payment-seo.ts` so `payment.astro` can emit FAQPage
// JSON-LD from the same array that renders here — see the note in that file.
const assurances = [
  'Free consultation included',
  'Response within 24 hours',
  'No long-term contracts',
];

const paymentBadges = ['256-bit SSL', 'Secured by Razorpay', 'UPI · Cards · Net Banking'];

const stepLabel = 'font-mono text-caption uppercase tracking-[0.08em] text-mute';

const razorpayKey = import.meta.env.PUBLIC_RAZORPAY_KEY_ID ?? '';
---

{/* ── Success state, swapped in after the brief is sent ──
     This and #payment-page are mutually exclusive: exactly one is visible at
     a time, so the document always exposes exactly one top-level heading.
     The hidden branch is removed from the accessibility tree by `hidden`. */}
<div
  id="brief-sent"
  hidden
  class="flex min-h-[60vh] items-center justify-center bg-canvas"
>
  <div class="mx-auto w-full max-w-md px-6 text-center">
    <span
      class="mx-auto mb-6 flex size-20 items-center justify-center rounded-full bg-canvas-soft text-ink shadow-level-2"
    >
      <CheckCircle2 size={40} aria-hidden="true" />
    </span>
    <h1 class="text-display-xl">Brief Sent!</h1>
    <p class="mt-4 mb-8 text-body-md text-body">
      Your project brief has been sent via WhatsApp. We typically respond within
      a few hours with questions or a draft proposal.
    </p>
    <div class="flex justify-center gap-3">
      <Button href="/services" variant="secondary" size="md">
        Explore Services
      </Button>
      <Button href="/" variant="primary" size="md">Back to Home</Button>
    </div>
  </div>
</div>

<div id="payment-page">
  {/* ── Hero ── */}
  <section class="border-b border-hairline bg-canvas-soft band-tight">
    <div class="mx-auto w-full max-w-4xl px-4 text-center sm:px-6">
      <Reveal>
        <p
          class="mb-5 inline-flex items-center gap-2 rounded-full bg-canvas px-3 py-1.5 font-mono text-caption uppercase tracking-[0.08em] text-body shadow-level-1"
        >
          <MessageCircle size={14} aria-hidden="true" />
          Free Consultation · No Obligation
        </p>
        <h1 class="text-display-xl">
          Request a <span class="text-mute">Custom Proposal</span>
        </h1>
        <p class="mx-auto mt-4 mb-7 max-w-xl text-body-lg text-body">
          No fixed packages. Every engagement is scoped to your specific goals,
          industry, and budget. Tell us what you need and we'll put together a
          plan.
        </p>
        <ul
          class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-body-sm text-body"
        >
          {
            assurances.map((t) => (
              <li class="flex items-center gap-1.5">
                <CheckCircle2 size={14} class="text-mute" aria-hidden="true" />
                {t}
              </li>
            ))
          }
        </ul>
      </Reveal>
    </div>
  </section>

  {/* ── Inquiry form ── */}
  <section class="bg-canvas py-12 md:py-16">
    <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
      <Reveal>
        <form id="proposal-form" class="space-y-7">
          {/* Step 1 */}
          <Card surface="soft" elevation={1} padding="lg">
            <p class={stepLabel}>Step 1</p>
            <h2 class="mt-1 text-display-sm">Which services do you need?</h2>
            <p class="mt-1 mb-5 text-body-sm text-body">
              Select all that apply — we'll tailor the proposal accordingly.
            </p>

            {/* Real checkboxes: keyboard accessible and announced as a group
                 without any JS to manage selection state. */}
            <fieldset>
              <legend class="sr-only">Services needed</legend>
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                {
                  serviceOptions.map(({ icon, label }) => {
                    const Icon = icon as any;
                    return (
                      <label class="flex cursor-pointer items-center gap-2.5 rounded-md bg-canvas px-3 py-3 text-body-sm text-body shadow-level-1 transition-[color,box-shadow] hover:text-ink hover:shadow-level-2 has-checked:bg-ink has-checked:text-on-primary has-focus-visible:outline has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-link">
                        <input
                          type="checkbox"
                          name="services"
                          value={label}
                          class="sr-only"
                        />
                        <Icon size={16} class="shrink-0" aria-hidden="true" />
                        <span class="leading-tight">{label}</span>
                      </label>
                    );
                  })
                }
              </div>
            </fieldset>
          </Card>

          {/* Step 2 */}
          <Card surface="soft" elevation={1} padding="lg" class="space-y-5">
            <div>
              <p class={stepLabel}>Step 2</p>
              <h2 class="mt-1 text-display-sm">About your project</h2>
            </div>

            <Field
              name="brief"
              type="textarea"
              rows={3}
              label="What do you want to achieve? (optional)"
              placeholder="e.g. We want to rank on the first page for keywords related to our products and generate 50+ leads per month…"
            />

            <Field
              name="budget"
              type="select"
              label="Rough monthly / project budget"
              placeholder="Select a range…"
              options={budgetRanges}
            />
          </Card>

          {/* Step 3 */}
          <Card surface="soft" elevation={1} padding="lg" class="space-y-5">
            <div>
              <p class={stepLabel}>Step 3</p>
              <h2 class="mt-1 text-display-sm">Your contact details</h2>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
              <Field name="name" label="Full Name" required placeholder="Your name" />
              <Field
                name="email"
                type="email"
                label="Email Address"
                required
                placeholder="you@company.com"
              />
              <Field
                name="phone"
                type="tel"
                label="WhatsApp / Phone"
                placeholder="+91 98765 43210"
              />
            </div>

            <p class="flex items-start gap-1.5 text-caption text-mute">
              <Lock size={12} class="mt-0.5 shrink-0" aria-hidden="true" />
              Your details are only used to respond to this enquiry. We never share
              or sell contact information.
            </p>
          </Card>

          <p id="proposal-error" hidden class="text-body-sm text-error" role="alert">
            Please select at least one service.
          </p>

          <div class="flex flex-col gap-3 sm:flex-row">
            <Button type="submit" variant="primary" size="lg" class="flex-1">
              <MessageCircle size={16} aria-hidden="true" />
              Send My Project Brief via WhatsApp
              <ArrowRight size={16} aria-hidden="true" />
            </Button>
            <Button href="/contact" variant="secondary" size="lg">
              Use Contact Form Instead
            </Button>
          </div>
        </form>
      </Reveal>
    </div>
  </section>

  {/* ── Trust cards ── */}
  <section class="border-t border-hairline bg-canvas-soft py-12 md:py-16">
    <div class="container-page">
      <Reveal class="mb-10 text-center">
        <Eyebrow class="mb-3">Why clients choose Auravon AI</Eyebrow>
        <h2 class="text-display-lg">We work differently</h2>
      </Reveal>

      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          trustCards.map(({ icon, title, desc }, i) => {
            const Icon = icon as any;
            return (
              <Reveal as="li" delay={i * 80} class="flex">
                <Card surface="canvas" elevation={2} padding="sm" class="flex-1">
                  <span class="mb-4 flex size-10 items-center justify-center rounded-md bg-canvas-soft text-ink">
                    <Icon size={20} aria-hidden="true" />
                  </span>
                  <h3 class="text-body-md font-medium text-ink">{title}</h3>
                  <p class="mt-2 text-body-sm text-body">{desc}</p>
                </Card>
              </Reveal>
            );
          })
        }
      </ul>
    </div>
  </section>

  {/* ── Pay an invoice ── */}
  <section class="border-t border-hairline bg-canvas py-12">
    <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
      <Reveal>
        <Card surface="canvas" elevation={2} padding="sm" class="!p-0">
          <details class="group">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 transition-colors hover:bg-canvas-soft [&::-webkit-details-marker]:hidden"
            >
              <span class="flex items-center gap-3">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-canvas-soft text-ink">
                  <CreditCard size={16} aria-hidden="true" />
                </span>
                <span class="text-left">
                  <span class="block text-body-md font-medium text-ink">
                    Pay an Invoice
                  </span>
                  <span class="block text-body-sm text-body">
                    Already have an approved proposal? Pay securely via Razorpay.
                  </span>
                </span>
              </span>
              <ChevronDown
                size={16}
                class="shrink-0 text-mute transition-transform duration-200 group-open:rotate-180" aria-hidden="true" />
            </summary>

            <div class="border-t border-hairline px-6 pt-4 pb-6">
              <div id="invoice-form" class="space-y-4">
                <div class="grid gap-4 sm:grid-cols-3">
                  <Field name="payerName" label="Full Name" required placeholder="Your name" />
                  <Field
                    name="payerEmail"
                    type="email"
                    label="Email Address"
                    required
                    placeholder="you@company.com"
                  />
                  <Field
                    name="payerPhone"
                    type="tel"
                    label="Phone (optional)"
                    placeholder="+91 98765 43210"
                  />
                </div>

                <div class="flex items-end gap-3">
                  <div class="flex-1">
                    <label
                      for="field-invoiceAmount"
                      class="mb-1.5 block text-body-sm font-medium text-body"
                    >
                      Invoice Amount (INR)
                      <span class="text-error" aria-hidden="true">*</span>
                    </label>
                    <div class="relative">
                      <span
                        class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-body-md text-mute"
                        aria-hidden="true">₹</span
                      >
                      <input
                        id="field-invoiceAmount"
                        type="number"
                        name="invoiceAmount"
                        min="1000"
                        step="1"
                        inputmode="numeric"
                        autocomplete="off"
                        placeholder="e.g. 25000"
                        class="h-12 w-full rounded-sm bg-canvas pr-3 pl-7 text-body-md tabular-nums text-ink shadow-level-1 transition-shadow duration-150 placeholder:text-mute focus:shadow-[inset_0_0_0_1px_var(--color-link)]"
                      />
                    </div>
                    <p class="mt-1 text-caption text-mute">Minimum: ₹1,000</p>
                  </div>

                  <Button
                    id="pay-invoice"
                    type="button"
                    variant="primary"
                    size="lg"
                    class="mb-6 shrink-0"
                  >
                    <Lock size={14} aria-hidden="true" />
                    <span data-pay-label>Pay Invoice</span>
                  </Button>
                </div>

                <p id="invoice-error" hidden class="text-body-sm text-error" role="alert"></p>

                <ul class="flex flex-wrap gap-4 pt-1">
                  {
                    paymentBadges.map((label) => (
                      <li class="flex items-center gap-1.5 text-caption text-mute">
                        <Shield size={12} aria-hidden="true" />
                        {label}
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div id="invoice-success" hidden class="py-4 text-center" role="status">
                <CheckCircle2 size={40} class="mx-auto mb-3 text-ink" aria-hidden="true" />
                <h3 class="text-display-sm">Payment Confirmed</h3>
                <p class="mt-1 mb-3 text-body-sm text-body">
                  We'll be in touch within 24 hours to confirm and get started.
                </p>
                <p class="text-caption text-mute">
                  Payment ID:
                  <span class="font-mono text-body" data-payment-id></span>
                </p>
              </div>
            </div>
          </details>
        </Card>
      </Reveal>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="border-t border-hairline bg-canvas py-12 md:py-16">
    <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
      <Reveal class="mb-8 text-center">
        <Eyebrow class="mb-3">Before you submit</Eyebrow>
        <h2 class="text-display-lg">Common Questions</h2>
      </Reveal>

      <Reveal>
        <Card surface="soft" elevation={1} class="px-6 py-1">
          {
            paymentFaqs.map((faq) => (
              <Accordion question={faq.question} name="payment-faq" headingLevel="h3">
                {faq.answer}
              </Accordion>
            ))
          }
        </Card>
      </Reveal>

      <Reveal delay={200} class="mt-8 text-center">
        <p class="mb-3 text-body-sm text-body">Still have questions?</p>
        <a
          href={`https://wa.me/${WHATSAPP_NUMBER}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-body-md text-link transition-colors hover:text-link-deep"
        >
          Chat with us on WhatsApp
          <ArrowRight size={14} aria-hidden="true" />
        </a>
      </Reveal>
    </div>
  </section>
</div>

<script define:vars={{ whatsappNumber: WHATSAPP_NUMBER, razorpayKey }}>
  // ── Proposal brief → WhatsApp deep link ──────────────────────────
  const page = document.getElementById('payment-page');
  const sent = document.getElementById('brief-sent');
  const form = document.getElementById('proposal-form');
  const formError = document.getElementById('proposal-error');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const services = data.getAll('services').map(String);

    if (services.length === 0) {
      if (formError) formError.hidden = false;
      return;
    }
    if (formError) formError.hidden = true;

    const get = (key) => String(data.get(key) ?? '').trim() || '—';

    const message =
      `Hi Auravon AI,\n\nI'd like to request a proposal.\n\n` +
      `Services needed: ${services.join(', ')}\n\n` +
      `Project brief: ${get('brief')}\n\n` +
      `Budget: ${get('budget')}\n\n` +
      `Name: ${get('name')}\n` +
      `Email: ${get('email')}\n` +
      `Phone: ${get('phone')}`;

    window.open(
      `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`,
      '_blank',
      'noopener,noreferrer',
    );

    if (page) page.hidden = true;
    if (sent) sent.hidden = false;
    window.scrollTo({ top: 0 });
  });

  // ── Razorpay invoice payment ─────────────────────────────────────
  const payButton = document.getElementById('pay-invoice');
  const payLabel = payButton?.querySelector('[data-pay-label]');
  const invoiceForm = document.getElementById('invoice-form');
  const invoiceSuccess = document.getElementById('invoice-success');
  const invoiceError = document.getElementById('invoice-error');

  const MINIMUM = 1000;

  function showInvoiceError(message) {
    if (!invoiceError) return;
    invoiceError.textContent = message;
    invoiceError.hidden = false;
  }

  function loadRazorpay() {
    if (window.Razorpay) return Promise.resolve(true);
    return new Promise((resolve) => {
      const script = document.createElement('script');
      script.src = 'https://checkout.razorpay.com/v1/checkout.js';
      script.onload = () => resolve(true);
      script.onerror = () => resolve(false);
      document.body.appendChild(script);
    });
  }

  function fieldValue(name) {
    const el = document.querySelector(`[name="${name}"]`);
    return el ? el.value.trim() : '';
  }

  function setBusy(busy) {
    if (!payButton) return;
    payButton.disabled = busy;
    if (payLabel) payLabel.textContent = busy ? 'Processing…' : 'Pay Invoice';
  }

  payButton?.addEventListener('click', async () => {
    if (invoiceError) invoiceError.hidden = true;

    const name = fieldValue('payerName');
    const email = fieldValue('payerEmail');
    const phone = fieldValue('payerPhone');
    const amount = Number(fieldValue('invoiceAmount'));

    if (!name || !email) {
      showInvoiceError('Please enter your name and email.');
      return;
    }
    if (!Number.isFinite(amount) || amount < MINIMUM) {
      showInvoiceError('Minimum payment amount is ₹1,000.');
      return;
    }
    if (!razorpayKey) {
      showInvoiceError('Payment gateway is not configured. Please contact us directly.');
      return;
    }

    setBusy(true);

    try {
      const orderRes = await fetch('/api/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount, planName: 'Invoice Payment' }),
      });

      if (!orderRes.ok) {
        showInvoiceError('Could not initiate payment. Please try again.');
        setBusy(false);
        return;
      }

      const { orderId } = await orderRes.json();

      if (!(await loadRazorpay())) {
        showInvoiceError('Payment gateway could not be loaded. Please try again.');
        setBusy(false);
        return;
      }

      const rzp = new window.Razorpay({
        key: razorpayKey,
        amount: amount * 100,
        currency: 'INR',
        order_id: orderId,
        name: 'Auravon AI',
        description: 'Invoice Payment',
        prefill: { name, email, contact: phone },
        theme: { color: '#171717' },
        modal: { ondismiss: () => setBusy(false) },
        handler: async (response) => {
          const verify = await fetch('/api/verify-payment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(response),
          });

          if (verify.ok) {
            const idEl = invoiceSuccess?.querySelector('[data-payment-id]');
            if (idEl) idEl.textContent = response.razorpay_payment_id;
            if (invoiceForm) invoiceForm.hidden = true;
            if (invoiceSuccess) invoiceSuccess.hidden = false;
          } else {
            showInvoiceError(
              `Verification failed. Payment ID: ${response.razorpay_payment_id}`,
            );
          }
          setBusy(false);
        },
      });

      rzp.open();
    } catch {
      showInvoiceError('Something went wrong. Please try again.');
      setBusy(false);
    }
  });
</script>
