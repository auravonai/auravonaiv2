---
import Sun from 'lucide-astro/Sun';
import Moon from 'lucide-astro/Moon';

/**
 * Light / dark switch — DESIGN.md `icon-button-circular`.
 *
 * The chosen theme is applied by an inline script in BaseLayout before first
 * paint, so this component never causes a flash. Until that script runs the
 * button renders both glyphs and the script hides the wrong one, which keeps
 * the markup identical for every prerendered page (there is no server-side
 * "current theme" to render against on a static build).
 */
interface Props {
  /** `full` adds a visible text label, for the mobile drawer. */
  variant?: 'icon' | 'full';
  class?: string;
}

const { variant = 'icon', class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch theme"
  class:list={[
    'group inline-flex shrink-0 items-center justify-center text-body shadow-level-1 ' +
      'transition-[color,box-shadow] duration-150 hover:text-ink hover:shadow-level-2',
    variant === 'full'
      ? 'w-full gap-2.5 rounded-md px-4 py-3 text-body-md'
      : 'size-9 rounded-full',
    className,
  ]}
>
  {/* Exactly one of these is unhidden by the theme script. */}
  <Sun size={16} data-theme-icon="light" class="hidden" aria-hidden="true" />
  <Moon size={16} data-theme-icon="dark" class="hidden" aria-hidden="true" />

  {
    variant === 'full' && (
      <span data-theme-label>Theme</span>
    )
  }
</button>
