---
/**
 * Section eyebrow.
 *
 * DESIGN.md: "Every section eyebrow and small label uses the monospace
 * face" — mono is the voice of the technical layer. This is the one place
 * the system uses uppercase; headlines never do.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class:list={[
    'inline-block font-mono text-caption uppercase tracking-[0.08em] text-mute',
    className,
  ]}
>
  <slot />
</span>
