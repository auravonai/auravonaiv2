---
import ArrowRight from 'lucide-astro/ArrowRight';

/**
 * A routing list inside a `HeroPanel` — the hub panels' workhorse.
 *
 * Every row is a real internal link. This is the part of the hero redesign
 * that pays for itself in SEO terms: a hub used to link to its children only
 * from the card grid far below the fold, and now links to them from the hero
 * band as well, with descriptive anchor text and a count beside each.
 *
 * `meta` is deliberately terse ("15 pages", "4 builds"). It tells a visitor
 * how big the section is before they commit to a click, which is the one
 * question a hub exists to answer.
 */
interface Props {
  items: {
    label: string;
    href: string;
    /** Short right-aligned count or qualifier. */
    meta?: string;
  }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['-my-1', className]}>
  {
    items.map((item) => (
      <li>
        <a
          href={item.href}
          class="group flex items-center gap-3 rounded-sm py-2 text-body-sm transition-colors hover:text-link"
        >
          <span class="min-w-0 flex-1 truncate text-ink transition-colors group-hover:text-link">
            {item.label}
          </span>
          {item.meta && (
            <span class="shrink-0 font-mono text-caption text-mute">
              {item.meta}
            </span>
          )}
          <ArrowRight
            size={13}
            class="shrink-0 text-mute transition-transform duration-150 group-hover:translate-x-0.5 group-hover:text-link"
            aria-hidden="true"
          />
        </a>
      </li>
    ))
  }
</ul>
