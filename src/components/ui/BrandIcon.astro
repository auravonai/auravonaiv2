/**
 * Official brand marks for the social profiles the footer links to.
 *
 * Why these are not Lucide icons
 * -----------------------------
 * Lucide still ships `Twitter`, `Linkedin`, `Instagram` and `Github`, but it
 * deprecated its whole brand set and it shows: `Twitter` is the retired bird,
 * not the X mark, and there is no WhatsApp glyph at all. The footer was
 * standing in a generic `Globe` for LinkedIn and a `Code2` for GitHub for
 * exactly that reason. A recognisable logo is the entire job of a social
 * icon, so these are the real marks.
 *
 * They are filled paths on a 24-unit viewBox rather than Lucide's 24-unit
 * stroked grid, which is correct — every one of these logos is defined as a
 * solid shape by its owner, and stroking it would be a redrawing, not a
 * rendering.
 *
 * Theming: `fill="currentColor"` and nothing else. The mark takes the colour
 * of whatever it sits in, so the footer's `text-body` → `hover:text-ink`
 * transition carries it, and light and dark both resolve from the same token
 * with no per-theme rule and no second asset.
 */
interface Props {
  name: 'instagram' | 'linkedin' | 'x' | 'whatsapp';
  size?: number;
  class?: string;
}

const { name, size = 14, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
