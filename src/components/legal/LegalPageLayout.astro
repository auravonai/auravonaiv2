---
import Calendar from 'lucide-astro/Calendar';
import ChevronRight from 'lucide-astro/ChevronRight';

import Card from '@/components/ui/Card.astro';
import PageHero from '@/components/ui/PageHero.astro';
import HeroPanel from '@/components/ui/HeroPanel.astro';
import HeroPanelBlock from '@/components/ui/HeroPanelBlock.astro';

/**
 * Shared chrome for the three legal documents.
 *
 * The reference's sidebar used buttons with a JS `scrollIntoView` handler;
 * these are plain anchors instead — same smooth scroll (handled by
 * `scroll-behavior` in global.css), but they work without JS, can be
 * opened in a new tab, and are announced correctly as links.
 */
interface Props {
  badge: string;
  title: string;
  subtitle: string;
  lastUpdated: string;
  sections: { id: string; title: string }[];
}

const { badge, title, subtitle, lastUpdated, sections } = Astro.props;
---

{/* ── Hero strip ──────────────────────────────────────────────────────
    The "Back to Home" link became a real breadcrumb. Same destination, but
    it now states where the page sits rather than only offering an exit, and
    it matches the trail every other page on the site shows.

    "Last updated" moved into the panel beside the document facts. On a legal
    document that date is the single most-checked value on the page, and it
    was previously the last line of a hero a reader had to scroll past. */}
<PageHero
  eyebrow={badge}
  title={title}
  lead={subtitle}
  backdrop="rules"
  asideWidth="sm"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: title }]}
>
  <HeroPanel
    slot="aside"
    footerLabel="Questions about this?"
    footerHref="/contact"
    footerCta="Contact us"
  >
    <HeroPanelBlock label="This document">
      <dl class="space-y-3">
        <div class="flex items-baseline justify-between gap-3">
          <dt class="flex items-center gap-1.5 text-body-sm text-body">
            <Calendar size={13} class="text-mute" aria-hidden="true" />
            Last updated
          </dt>
          <dd class="text-body-sm text-ink">{lastUpdated}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-3">
          <dt class="text-body-sm text-body">Sections</dt>
          <dd class="font-mono text-body-sm text-ink tabular-nums">
            {sections.length}
          </dd>
        </div>
      </dl>
    </HeroPanelBlock>
  </HeroPanel>
</PageHero>

{/* ── Content ── */}
<div class="container-page py-12 md:py-16">
  <div class="grid items-start gap-12 lg:grid-cols-[240px_1fr]">
    {/* Sidebar TOC */}
    <aside class="sticky top-24 hidden lg:block">
      <Card surface="soft" elevation={1} padding="sm">
        <p class="mb-3 font-mono text-caption uppercase tracking-[0.08em] text-mute">
          Contents
        </p>
        <nav aria-label="Document sections">
          <ul class="space-y-0.5">
            {
              sections.map((s) => (
                <li>
                  <a
                    href={`#${s.id}`}
                    class="group flex items-center gap-2 rounded-sm px-3 py-2 text-body-sm text-body transition-colors hover:bg-canvas hover:text-ink"
                  >
                    <ChevronRight
                      size={12}
                      class="shrink-0 text-mute opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true" />
                    {s.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </Card>

      <Card surface="soft" elevation={1} padding="sm" class="mt-3">
        <p class="mb-2 text-body-sm text-body">Questions about this policy?</p>
        <a
          href="/contact"
          class="text-body-sm text-link transition-colors hover:text-link-deep"
        >
          Contact us →
        </a>
      </Card>
    </aside>

    {/* Prose */}
    <article class="prose-doc min-w-0">
      <slot />
    </article>
  </div>
</div>
