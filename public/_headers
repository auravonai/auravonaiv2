# Read by Cloudflare Workers Static Assets (and Netlify) at serve time.
#
# This used to be generated: @astrojs/cloudflare injected the rule below on
# every build ("Injected immutable Cache-Control for /_astro/* into _headers").
# The adapter was removed along with the payment API routes, and the rule went
# with it — without this file, hashed assets fall back to the default
# short-lived caching and repeat visitors re-download the CSS and JS.
#
# It lives in `public/` rather than being written into `dist/` by an
# integration because it is genuinely hand-maintained source, not a build
# artefact derived from something else. Contrast `_redirects`, which IS
# generated (see the `auravon:host-redirects` integration in astro.config.mjs)
# because its content is derived from src/lib/marketing.ts.

# Everything under /_astro/ is content-hashed by Vite, so the filename changes
# whenever the bytes change. That makes it safe to cache for a year and to
# mark immutable, which also tells the browser not to revalidate.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The icons and the manifest are NOT content-hashed — they live at fixed paths
# because the spec, the browser, or a link tag requires it. They were falling
# through to the host default, which is what Lighthouse's "use efficient cache
# lifetimes" finding was pointing at; the favicon and the manifest are fetched
# on every visit and were being revalidated every time.
#
# Thirty days rather than a year, and deliberately not `immutable`: the file
# name cannot change when the artwork does, so a long immutable TTL would
# strand a stale favicon in caches with no way to bust it. A month is long
# enough that Lighthouse stops counting it against the page and short enough
# that a rebrand propagates on its own.
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon-96x96.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/web-app-manifest-192x192.png
  Cache-Control: public, max-age=2592000
/web-app-manifest-512x512.png
  Cache-Control: public, max-age=2592000
/og-image.png
  Cache-Control: public, max-age=2592000
/logo.png
  Cache-Control: public, max-age=2592000

# The manifest is re-fetched on install and on some navigations. Same
# reasoning as the icons, shorter window because it is cheap to refetch and
# more likely to change than artwork.
/site.webmanifest
  Cache-Control: public, max-age=604800
