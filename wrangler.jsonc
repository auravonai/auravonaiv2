{
  // Cloudflare Workers Static Assets + a tiny API Worker.
  //
  // Every route in src/pages/ still prerenders (`output: 'static'`, no
  // adapter) and is served straight from Cloudflare's edge. The Worker in
  // `worker/index.ts` exists only for the ₹1,000 booking payment
  // (/api/booking/*): `run_worker_first` limits it to /api/*, so page, image
  // and video requests never invoke it and page speed is unchanged.
  //
  // Secrets — set once, never commit:
  //   npx wrangler secret put RAZORPAY_KEY_ID
  //   npx wrangler secret put RAZORPAY_KEY_SECRET
  //   npx wrangler secret put CALENDLY_URL
  //
  // This also means no `compatibility_flags: ["nodejs_compat"]`. That flag
  // existed for the two Razorpay endpoints — `node:crypto` in
  // verify-payment.ts, the Node-based `razorpay` SDK in create-order.ts —
  // and both were deleted with the payment page.
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "auravon-ai",
  "compatibility_date": "2026-04-15",
  "main": "./worker/index.ts",

  // Serve ONLY on auravonai.com. No public *.workers.dev copy of the site
  // (a duplicate-content and security liability) and no per-version preview
  // URLs. Custom-domain routing is managed in the Cloudflare dashboard.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    // ./dist, not ./dist/client — the adapter's two-directory split went away
    // with the adapter. Astro writes a flat static build here now.
    "directory": "./dist",
    "binding": "ASSETS",

    // The Worker runs for these paths only; everything else is a pure
    // static-asset hit, exactly as before.
    "run_worker_first": ["/api/*"],

    // Without this, an unknown URL returns Cloudflare's blank 404 and the
    // custom /404.html is never served. `404-page` also makes the response a
    // real 404 status rather than a 200, which is what stops every bad URL
    // becoming a soft 404 in Search Console.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
